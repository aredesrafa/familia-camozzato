// Hospedagem na Cloudflare: Worker só com arquivos estáticos (o site gerado em dist/).
// Produção: `wrangler deploy`. Prévia da branch conteudo: `wrangler versions upload --preview-alias conteudo`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "familia-camozzato",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true
}
