---
import type { CollectionEntry } from 'astro:content';
interface Props { marcos: CollectionEntry<'marcos'>[] }
const { marcos } = Astro.props;
---
<ol class="tl">
  {marcos.map((m) => (
    <li>
      <span class="date">{m.data.data}</span>
      <div>
        <h3>{m.data.titulo}</h3>
        <p>{m.data.descricao}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .tl { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  li { display: grid; grid-template-columns: 1fr; gap: 4px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 700px) { li { grid-template-columns: 150px 1fr; gap: 32px; } }
  .date { color: var(--navy); font-size: 15px; padding-top: 3px; }
  h3 { font-size: 19px; color: var(--ink); }
  p { font-size: 16px; color: var(--ink-soft); }
</style>
