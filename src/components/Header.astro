---
// Seções ainda sem página própria apontam para a seção correspondente da página inicial.
const nav = [
  { href: '/familia/', label: 'A família' },
  { href: '/linha-do-tempo/', label: 'Linha do tempo' },
  { href: '/arvore/', label: 'Árvore' },
  { href: '/historias/', label: 'Histórias' },
  { href: '/cidades/', label: 'Lugares' },
  { href: '/fotos/', label: 'Acervo' },
  { href: '/#contribua', label: 'Contribua' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.startsWith('/#') && path.startsWith(href);
---
<header class="site">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Família Camozzato — início">
      <svg width="34" height="40" viewBox="0 0 34 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M12 38 C11 28 10 18 11 11 C12 5 15 2 18 3 C20 4 19.5 7 17.5 7.5" />
        <path d="M22 38 C23 28 24 18 23 11 C22.5 7 24 4.5 26.5 4.6 C28.6 4.8 28.6 7.4 26.8 8" />
        <path d="M12.6 22 h8.8 M12.2 28 h9.6" stroke-width="1" opacity=".5" />
      </svg>
      <span><span class="brand-name">Família <em>Camozzato</em></span><span class="brand-sub">CAMUZZATO · CAMOSSATO</span></span>
    </a>
    <nav class="main" aria-label="Principal">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false">Menu</button>
  </div>
</header>

<script>
  const header = document.querySelector('header.site');
  const btn = header?.querySelector<HTMLButtonElement>('.menu-btn');
  btn?.addEventListener('click', () => {
    const open = header!.classList.toggle('nav-open');
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Fechar' : 'Menu';
  });
</script>

<style>
  header.site { background: var(--cream); border-bottom: 1px solid var(--line); position: relative; z-index: 10; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 84px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--navy); }
  .brand svg { flex: none; }
  .brand-name { font-size: 26px; line-height: 1.05; white-space: nowrap; }
  .brand-name em { font-style: italic; }
  .brand-sub { display: block; font-size: 12px; color: var(--ink-mute); letter-spacing: .08em; margin-top: 3px; }
  nav.main ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 28px; align-items: center; }
  nav.main a { color: var(--navy); text-decoration: none; font-size: 17px; padding: 6px 0; border-bottom: 2px solid transparent; white-space: nowrap; }
  nav.main a:hover, nav.main a[aria-current] { border-bottom-color: var(--accent); }
  .menu-btn { display: none; }
  @media (max-width: 1120px) {
    nav.main { display: none; }
    .menu-btn { display: inline-flex; background: none; border: 1px solid var(--line); border-radius: 8px; padding: 8px 14px; font: inherit; font-size: 15px; color: var(--navy); cursor: pointer; }
    .bar { min-height: 70px; }
    .brand-name { font-size: 22px; }
    .nav-open nav.main { display: block; position: absolute; top: 100%; left: 0; right: 0; background: var(--cream); border-bottom: 1px solid var(--line); padding: 8px var(--gut) 20px; }
    .nav-open nav.main ul { flex-direction: column; align-items: stretch; gap: 0; }
    .nav-open nav.main a { display: block; padding: 12px 0; border-bottom: 1px solid var(--line); }
  }
</style>
