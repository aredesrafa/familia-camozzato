---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const cidades = await getCollection('cidades');
  return cidades.map((c) => ({ params: { id: c.id }, props: { cidade: c } }));
}

const { cidade } = Astro.props;
const d = cidade.data;
const { Content } = await render(cidade);
---
<Base title={d.nome} description={d.resumo}>
  <header class="page-head">
    <div class="wrap">
      <p class="meta"><a class="link" href="/cidades/">Lugares</a> · {d.regiao}</p>
      <h1>{d.nome}</h1>
    </div>
  </header>
  <article class="wrap block">
    {d.imagem && <figure class="frame"><img src={d.imagem} alt={d.imagem_alt ?? ''} /></figure>}
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .page-head .meta { margin-bottom: 14px; }
  .frame { max-width: 720px; margin-bottom: 40px; }
</style>
