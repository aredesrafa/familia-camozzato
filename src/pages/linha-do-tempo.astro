---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import { porData } from '../lib';

const marcos = (await getCollection('marcos')).sort(porData);
---
<Base title="Linha do tempo">
  <header class="page-head">
    <div class="wrap">
      <h1>Linha do tempo</h1>
      <p class="lead">Cada marco é datado a partir de um registro: listas de passageiros, livros de matrícula de colonos, certidões e o livro de José Camozzato.</p>
    </div>
  </header>
  <div class="wrap block">
    <Timeline marcos={marcos} />
  </div>
</Base>
