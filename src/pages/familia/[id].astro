---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const paginas = (await getCollection('paginas')).sort((a, b) => a.data.ordem - b.data.ordem);
  return paginas.map((p, i) => ({
    params: { id: p.id },
    props: { pagina: p, anterior: paginas[i - 1], proxima: paginas[i + 1] },
  }));
}

const { pagina, anterior, proxima } = Astro.props;
const d = pagina.data;
const { Content } = await render(pagina);
---
<Base title={d.titulo} description={d.resumo}>
  <header class="page-head">
    <div class="wrap">
      <p class="meta"><a class="link" href="/familia/">A família</a></p>
      <h1>{d.titulo}</h1>
      <p class="lead">{d.resumo}</p>
    </div>
  </header>
  <article class="wrap block">
    <div class="prose"><Content /></div>
    <nav class="pager" aria-label="Outras páginas">
      {anterior ? <a class="link" href={`/familia/${anterior.id}/`}>← {anterior.data.titulo}</a> : <span></span>}
      {proxima && <a class="link" href={`/familia/${proxima.id}/`}>{proxima.data.titulo} →</a>}
    </nav>
  </article>
</Base>

<script>
  // Tabelas com uma coluna de números (ex.: emigração por região) ganham barras proporcionais
  // atrás dos valores. Sem JavaScript, continua sendo uma tabela comum. Linhas de "Total" ficam de fora.
  const numero = (s: string) => Number(s.replace(/[^\d,]/g, '').replace(',', '.'));
  document.querySelectorAll<HTMLTableElement>('.prose table').forEach((t) => {
    const linhas = [...t.tBodies[0]?.rows ?? []].filter((r) => r.cells.length === 2 && !/total/i.test(r.cells[0].textContent ?? ''));
    const valores = linhas.map((r) => numero(r.cells[1].textContent ?? ''));
    if (linhas.length < 3 || valores.some((v) => !Number.isFinite(v) || v <= 0)) return;
    const max = Math.max(...valores);
    t.classList.add('barras');
    linhas.forEach((r, i) => {
      r.cells[1].style.setProperty('--p', `${(valores[i] / max) * 100}%`);
      if (valores[i] === max) r.classList.add('maior');
    });
  });
</script>

<style>
  .page-head .meta { margin-bottom: 14px; }
  .pager { display: flex; justify-content: space-between; gap: 16px 32px; flex-wrap: wrap; border-top: 1px solid var(--line); margin-top: 48px; padding-top: 24px; font-size: 17px; max-width: 40em; }
</style>
